+    /** SQL proof for the daily count. The enclosing query must use posts alias p. */
+    public static function completionCondition(): string
+    {
+        global $wpdb;
+        $uuid = '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$';
+        return $wpdb->prepare(
+            "EXISTS (
+                SELECT 1 FROM $wpdb->postmeta uid
+                JOIN $wpdb->postmeta f ON f.post_id=uid.post_id AND f.meta_key=%s
+                JOIN $wpdb->postmeta c ON c.post_id=uid.post_id AND c.meta_key=%s
+                WHERE uid.post_id=p.ID AND uid.meta_key=%s
+                  AND LOWER(uid.meta_value)=BINARY uid.meta_value AND uid.meta_value REGEXP %s
+                  AND LOWER(f.meta_value)=BINARY f.meta_value AND f.meta_value REGEXP '^[0-9a-f]{64}$'
+                  AND BINARY c.meta_value=BINARY CONCAT('1:',f.meta_value)
+                  AND NOT EXISTS (
+                      SELECT 1 FROM $wpdb->postmeta extra WHERE extra.post_id=p.ID AND
+                      ((extra.meta_key=uid.meta_key AND extra.meta_id<>uid.meta_id)
+                       OR (extra.meta_key=f.meta_key AND extra.meta_id<>f.meta_id)
+                       OR (extra.meta_key=c.meta_key AND extra.meta_id<>c.meta_id))
+                  )
+                  AND NOT EXISTS (
+                      SELECT 1 FROM $wpdb->postmeta d JOIN $wpdb->posts other ON other.ID=d.post_id
+                      WHERE d.meta_key=uid.meta_key AND BINARY d.meta_value=BINARY uid.meta_value
+                        AND d.post_id<>p.ID AND other.post_type='results'
+                  )
+            )", self::FINGERPRINT, self::COMPLETION, self::ID, $uuid
+        );
+    }
+
